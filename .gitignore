__pycache__/
*.pyc
files.zip

# Office temp/lock files
~$*

# Rust build output (also gitignored within jesus-twin/)
target/

# OpenCode session/loop state (keep the OpenSpec integration under .opencode/)
.opencode/opencode-loop/
unsloth_compiled_cache/

# Training output / downloaded models — large weight files, not for VCS.
# Fetch them with scripts/download-models.sh (see jesus-twin/README.md).
# (No inline comments: .gitignore only treats '#' as a comment at line start.)
# jesus-twin-merged/ = Unsloth-merged fine-tune (degenerate — see docs/FINDINGS.md)
# jesus-twin-base/ = base google/gemma-4-E4B-it (shipping generation model)
# jesus-twin-embeddinggemma/ = google/embeddinggemma-300m (retrieval embedder, 768-dim)
jesus-twin-merged/
jesus-twin-base/
jesus-twin-embeddinggemma/
*.gguf
unsloth_training_checkpoints/

# Generated eval reports (regenerate via eval/run.py + `jesus-twin gate calibrate`;
# the committed calibration baseline lives in docs/FINDINGS.md). Ignore the contents but
# keep the committed release test-prompt results log tracked.
eval/out/*
!eval/out/release-test-prompts.log

# Embedded SurrealDB stores (rebuild via `jesus-twin ingest --db ...`)
jesus-twin/twin.db/
jesus-twin/twin.db.*/
twin.db/
twin.db.*/

# Machine-draft modern text sidecar (modern-legs-v1) — regenerable, indexing-only
build/modern_drafts.jsonl
